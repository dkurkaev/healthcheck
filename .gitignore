# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User-specific
*.xcuserstate
xcuserdata/

## Build artifacts
build/
DerivedData/

## Schemes
# Remove-to-track-schemes
# xcshareddata/xcschemes/

## Swift Package Manager
.build/

## XCConfig
# .xcconfig files often contain secrets, so they're ignored by default
# *.xcconfig

## Other
.DS_Store
*.swp
*.lock
*.mode1v3
*.mode2v3
*.perspectivev3
!default.mode1v3
!default.mode2v3
!default.perspectivev3
